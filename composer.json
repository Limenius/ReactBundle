{
    "name": "limenius/react-bundle",
    "description": "Client and Server-side react rendering in a Symfony Bundle",
    "type": "symfony-bundle",
    "keywords": ["react", "isomorphic"],
    "license": "MIT",
    "authors": [
        {
            "name": "nacho",
            "email": "nacho@limenius.com"
        }
    ],
    "autoload": {
        "psr-4": { "Limenius\\ReactBundle\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": { "Limenius\\ReactBundle\\Tests\\": "Tests/" }
    },
    "require": {
        "php": ">=7.2",
        "symfony/config": "^2.7.0|^3.0.6|^4.0|^5.0|^6.0|^7.0",
        "symfony/http-kernel": "^2.7.0|^3.0.6|^4.0|^5.0|^6.0|^7.0",
        "symfony/dependency-injection": "^2.7.0|^3.0.6|^4.0|^5.0|^6.0|^7.0",
        "limenius/react-renderer": "^5.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5",
        "symfony/framework-bundle": "^5.4|^6.4|^7.0",
        "symfony/twig-bundle": "^5.4|^6.4|^7.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
